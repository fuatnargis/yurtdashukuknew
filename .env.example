# Copy to .env.local locally. Do not commit the filled file.
# Vercel: Project > Settings > Environment Variables.
# Supabase > Connect > Transaction pooler (port 6543).
# Percent-encode special characters in the database password.
HUKUK_DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:6543/postgres
HUKUK_SITE_URL=https://your-project.vercel.app
